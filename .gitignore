__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Generated pipeline outputs -- NOT tracked on main any more.
#
# These used to be committed back to main 8x/day by generate_ifr.yml and
# generate_mtn_obsc.yml, which required a thicket of negation exceptions
# below this line so 'git add output/' would actually stage them. That
# cost far more than it looked: .npz files don't delta-compress, so every
# scheduled run stored FULL fresh copies of ~20 MB of grids in history.
# The repo reached 2.2 GB against a 23.5 MB working tree, and Railway
# started failing at "Snapshot code" because cloning timed out.
#
# Each hazard workflow now force-pushes its own artifacts to its own
# orphan-style data branch (data-ifr / data-mtnobsc), rebuilt from
# scratch every run so those branches are permanently one commit deep,
# and the web app fetches them over HTTP at runtime (see
# webapp/artifacts.py). Nothing under output/ belongs in main's history
# any more -- hence a plain directory ignore with no exceptions.
#
# Local runs still write here exactly as before (pipeline/generate_latest_*.py
# create the directory if needed); the files are simply untracked, and the
# web app serves them from here in preference to anything it fetched
# remotely, so local pipeline output still shows up in the local map.
output/

# Runtime download cache for artifacts fetched from the data branches
# (webapp/artifacts.py). Ephemeral by design -- re-downloaded on restart.
.artifact-cache/

# Large cached terrain/DEM files - regenerate locally, don't commit
data/terrain/*.tif
data/terrain/*.tiff

.DS_Store
